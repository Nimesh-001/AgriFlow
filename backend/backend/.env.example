# AgriFlow Backend Environment Configuration Example
# Copy this file to .env or export these variables in your environment

PORT=8080
DB_URL=jdbc:mysql://localhost:3306/agriflow_db?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=your_secure_password_here
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
